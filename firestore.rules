rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny for all unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile and subcollections
    match /users/{userId} {
      allow read: if isOwner(userId);
      // Client cannot elevate privileges or mutate security fields
      allow create, update: if isOwner(userId) && (
        !('role' in request.resource.data) &&
        !('plan' in request.resource.data) &&
        !('quota' in request.resource.data) &&
        !('subscriptionStatus' in request.resource.data) &&
        !('admin' in request.resource.data)
      );
      allow delete: if isOwner(userId);

      // Meals subcollection
      match /meals/{mealId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
                             && isValidId(mealId)
                             && (!('uid' in request.resource.data) || request.resource.data.uid == userId);
        allow delete: if isOwner(userId) && isValidId(mealId);
      }

      // Weight logs subcollection
      match /weightLogs/{weightId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
                             && isValidId(weightId)
                             && (!('uid' in request.resource.data) || request.resource.data.uid == userId);
        allow delete: if isOwner(userId) && isValidId(weightId);
      }

      // Water logs subcollection
      match /waterLogs/{waterId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
                             && isValidId(waterId)
                             && (!('uid' in request.resource.data) || request.resource.data.uid == userId);
        allow delete: if isOwner(userId) && isValidId(waterId);
      }

      // Habits subcollection
      match /habits/{date} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
                             && isValidId(date)
                             && (!('uid' in request.resource.data) || request.resource.data.uid == userId);
        allow delete: if isOwner(userId) && isValidId(date);
      }

      // Calu AI memories subcollection
      match /memories/{memoryId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
                             && isValidId(memoryId)
                             && (!('uid' in request.resource.data) || request.resource.data.uid == userId);
        allow delete: if isOwner(userId) && isValidId(memoryId);
      }

      // AI Chat messages subcollection
      // Client can read their history, but cannot spoof Calu messages or alter history
      match /chatMessages/{messageId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
                     && isValidId(messageId)
                     && request.resource.data.sender == 'user'
                     && request.resource.data.uid == userId
                     && request.resource.data.text is string
                     && request.resource.data.text.size() > 0
                     && request.resource.data.text.size() <= 1000
                     && request.resource.data.keys().hasOnly(['id', 'uid', 'sender', 'text', 'timestamp']);
        allow update: if false; // Append-only: historical chat integrity
        allow delete: if isOwner(userId) && isValidId(messageId);
      }

      // AI Usage subcollection (Strictly server-side authoritative)
      match /aiUsage/{date} {
        allow read: if isOwner(userId);
        allow write: if false; // Only Firebase Admin SDK can write usage counters
      }

      // Preferences and profile document
      match /preferences/{docId} {
        allow read: if isOwner(userId);
        // Client SDK cannot elevate own account to premium or admin directly
        allow create, update: if isOwner(userId) && (
          !('role' in request.resource.data) &&
          !('admin' in request.resource.data) &&
          !('quota' in request.resource.data) &&
          (!('plan' in request.resource.data) ||
           request.resource.data.plan == 'free' ||
           (resource != null && resource.data.plan == request.resource.data.plan))
        );
        allow delete: if isOwner(userId);
      }

      // Goals document
      match /goals/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
                             && isValidId(docId)
                             && (!('uid' in request.resource.data) || request.resource.data.uid == userId);
        allow delete: if isOwner(userId) && isValidId(docId);
      }
    }
  }
}
